# Supabase → Postgres direct connection (Project Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Point at a scratch database for the rehearsal, production only when it passes.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=paizeis_migration_test
