# Copy to .env and fill in. The server validates all of this at boot and
# refuses to start if something required is missing.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB Atlas M0 (free). Must be a replica set for booking transactions —
# any Atlas cluster is; a local standalone mongod is not.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=paizeis

# Web dev server (Vite runs on 8080 in this project) and Expo web.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:19006

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Google Sign-In: comma-separated client ids (web, iOS, Android each have one).
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the app's bundle id, e.g. com.paizeis.app
APPLE_BUNDLE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Paizeis <noreply@paizeiscy.com>

# Cloudflare R2 (free tier) for avatars, venue images and the hero videos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paizeis-media
R2_PUBLIC_BASE_URL=

PUBLIC_WEB_URL=http://localhost:8080
MOBILE_DEEP_LINK_SCHEME=paizeis

SENTRY_DSN=
